# Coze（coze.cn 国内版）凭据
# COZE_PAT：coze.cn -> 个人设置 -> API 令牌 生成（注意权限范围与有效期）
# COZE_BOT_ID：智能体发布/调试页 URL 里的 bot_id（形如 7xxxxxx）
# COZE_BASE_URL：国内版默认地址，一般不用改
# COZE_USER_ID：Coze 侧用户标识，用于 auto_save_history，可自定义
COZE_PAT=你的Coze_API_令牌_PAT
COZE_BOT_ID=你的智能体bot_id
COZE_BASE_URL=https://api.coze.cn
COZE_USER_ID=cduestc-miniapp
PORT=3000
