/* pages/detail/detail.wxss */
.detail {
  min-height: 100vh;
  padding: 24rpx var(--gap-page) 0;
}

.d-block {
  margin-top: 24rpx;
}
.d-block--flush {
  margin-top: 16rpx;
}

/* 头部 */
.d-head {
  padding: 32rpx;
}
.d-head__top {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}
.d-head__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 28rpx;
  background: var(--color-primary-soft);
  font-size: 56rpx;
  flex-shrink: 0;
}
.d-head__main {
  flex: 1;
  min-width: 0;
}
.d-head__title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}
.d-head__title {
  font-size: 38rpx;
  font-weight: 800;
}
.d-head__summary {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-ink-sub);
  line-height: 1.5;
}
.d-head__fav {
  flex-shrink: 0;
  font-size: 48rpx;
  line-height: 1;
  color: #D8CFC4;
  padding: 8rpx;
}
.d-head__fav.is-fav {
  color: var(--color-primary);
}

/* 清单进度 */
.d-progress {
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
}
.d-progress__txt {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-ink-sub);
}
.d-progress__bar {
  margin-top: 14rpx;
  height: 12rpx;
  border-radius: var(--radius-pill);
  background: var(--color-primary-soft);
  overflow: hidden;
}
.d-progress__fill {
  height: 100%;
  border-radius: var(--radius-pill);
  background: linear-gradient(90deg, #FFB067, var(--color-primary));
  transition: width 0.2s;
}

/* 清单行 */
.d-check {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
}
.d-check__box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #E3D9CD;
  color: #fff;
  font-size: 26rpx;
  flex-shrink: 0;
}
.d-check.is-done .d-check__box {
  background: var(--color-primary);
  border-color: var(--color-primary);
}
.d-check__text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.6;
}
.d-check.is-done .d-check__text {
  color: var(--color-ink-sub);
  text-decoration: line-through;
}

/* 图文 */
.d-para {
  padding: 32rpx;
  margin-bottom: 16rpx;
}
.d-para__h {
  position: relative;
  padding-left: 20rpx;
  font-size: 30rpx;
  font-weight: 800;
}
.d-para__h::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: var(--color-primary);
}
.d-para__p {
  margin-top: 16rpx;
  font-size: 27rpx;
  line-height: 1.8;
  color: #5B4A3D;
}

/* 公告 */
.d-notice {
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  border-left: 8rpx solid var(--color-accent);
}
.d-notice__top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.d-notice__date {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  background: #EAF3FA;
  color: var(--color-accent);
  font-size: 22rpx;
  font-weight: 700;
}
.d-notice__title {
  font-size: 28rpx;
  font-weight: 700;
}
.d-notice__body {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--color-ink-sub);
  line-height: 1.7;
}

/* 外链/拨号 */
.d-link {
  padding: 32rpx;
}
.d-link__desc {
  font-size: 26rpx;
  color: var(--color-ink-sub);
  line-height: 1.7;
}
.d-link__btn {
  margin-top: 28rpx;
  padding: 24rpx 0;
  text-align: center;
}
.d-tel {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
}
.d-tel__label {
  font-size: 28rpx;
  font-weight: 600;
}
.d-tel__tel {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-ink-sub);
}
.d-tel__call {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
}

/* 表单 */
.d-form {
  padding: 32rpx;
}
.d-form__intro {
  font-size: 24rpx;
  color: var(--color-ink-sub);
  line-height: 1.6;
  margin-bottom: 8rpx;
}
.d-field {
  margin-top: 28rpx;
}
.d-field__label {
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.d-field__req {
  color: var(--color-danger);
}
.d-field__input {
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--color-line);
  border-radius: var(--radius-sm);
  background: #FCFAF7;
  font-size: 27rpx;
  color: var(--color-ink);
  line-height: 84rpx;
}
.d-field__textarea {
  height: 160rpx;
  padding: 20rpx 24rpx;
  line-height: 1.6;
}
.d-field__picker {
  display: flex;
  align-items: center;
}
.d-field__picker.is-ph {
  color: #B8AFA4;
}
.d-field__input.is-error {
  border-color: var(--color-danger);
}
.d-field__error {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-danger);
}
.d-form__submit {
  margin-top: 40rpx;
  padding: 26rpx 0;
  text-align: center;
}
