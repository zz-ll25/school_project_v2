/* components/entry-icon/entry-icon.wxss */
.entry {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.entry__circle {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--color-primary-soft);
}
.entry__icon {
  font-size: 46rpx;
  line-height: 1;
}
.entry__title {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-ink);
  text-align: center;
  line-height: 1.3;
}
.entry__badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: var(--radius-pill);
  background: var(--color-accent);
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
