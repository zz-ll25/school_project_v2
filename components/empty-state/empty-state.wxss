/* components/empty-state/empty-state.wxss */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}
.empty__icon {
  font-size: 96rpx;
  line-height: 1;
}
.empty__title {
  margin-top: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-ink-sub);
}
.empty__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-ink-sub);
  opacity: 0.8;
  text-align: center;
}
.empty__btn {
  margin-top: 40rpx;
  padding: 20rpx 64rpx;
}
