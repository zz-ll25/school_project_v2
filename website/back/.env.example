# 数据库（MySQL 8，本地开发）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=school_web

# 后端服务端口（8000 避免与小程序 relay 的 3000 冲突）
PORT=8000

# Coze AI（可选，留空则走本地知识库兜底，答辩无凭据也能演示）
COZE_PAT=
COZE_BOT_ID=
COZE_BASE_URL=https://api.coze.cn
COZE_USER_ID=cduestc-web

# 登录态有效期（天）
TOKEN_TTL_DAYS=7
